#lang racket/base

;;; gen-modelinfo.rkt — a ModelInfo document -> the ModelForm modelinfo.rkt loads, as a .rktd file.
;;;
;;;   racket model/gen-modelinfo.rkt [in.xml[.gz] out.rktd]   (default: the shipped FHIR 4.0.1)
;;;
;;; The reading is modelinfo-xml.rkt's (any model); this only writes it, so loading a shipped model
;;; costs a `read` instead of a 3 MB XML parse. A model in `current-model-directories` may also be
;;; left as XML: the registry reads it the same way when it is first asked for.

(require racket/runtime-path racket/pretty racket/path "modelinfo-xml.rkt")

(define-runtime-path fhir-src "fhir-modelinfo-4.0.1.xml.gz")
(define-runtime-path fhir-out "fhir-4.0.1.rktd")

;; write-model-form : in out -> void
(define (write-model-form in out)
  (define form (read-modelinfo-xml in))
  (call-with-output-file out #:exists 'truncate
    (lambda (o)
      (fprintf o ";; GENERATED by gen-modelinfo.rkt from ~a — do not edit\n" (file-name-from-path in))
      (parameterize ([pretty-print-columns 200]) (pretty-write form o))))
  (define (clause k) (cdr (assq k (filter pair? form))))
  (printf "wrote ~a: model ~a ~a, ~a types, ~a conversions, ~a contexts~a\n" out (list-ref form 1) (list-ref form 3)
          (length (clause 'types)) (length (clause 'conversions)) (length (clause 'contexts))
          (let ([t (car (clause 'target))]) (if t (format ", a view over ~a" t) ""))))

(module+ main
  (define args (current-command-line-arguments))
  (if (= (vector-length args) 2)
      (write-model-form (vector-ref args 0) (vector-ref args 1))
      (write-model-form fhir-src fhir-out)))
