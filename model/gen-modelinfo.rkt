#lang racket/base

;;; gen-modelinfo.rkt — ModelInfo XML (gzipped) -> the compact model data modelinfo.rkt reads.
;;;
;;; A ModelInfo (urn:hl7-org:elm-modelinfo:r1) describes a data model to the CQL translator: its
;;; classes, their elements and types, which classes are retrievable and by which code path, and the
;;; implicit conversions (FHIRHelpers.ToString etc.) into System types. We keep exactly that, as a
;;; readable s-expression, so loading costs a `read` instead of a 3 MB XML parse.
;;;
;;; Output data definition (one `model` form):
;;;   (model name url version patient-class birth-date-path
;;;          (types (type name base identifier primary-code-path retrievable? ((elt-name type-spec) …)) …)
;;;          (conversions (from-type to-type function-name) …)
;;;          (contexts (name key-element type-name) …))
;;; A type-spec is one of: "Ns.Name" | (list T) | (interval T) | (choice T …)

(require xml racket/list racket/match racket/port file/gunzip racket/runtime-path racket/pretty)

(define-runtime-path src "fhir-modelinfo-4.0.1.xml.gz")
(define-runtime-path out "fhir-4.0.1.rktd")

;; read-gz-xml : path -> xexpr
(define (read-gz-xml p)
  (define bs (call-with-input-file p
               (lambda (in) (call-with-output-bytes (lambda (o) (gunzip-through-ports in o))))))
  (parameterize ([collapse-whitespace #t] [xexpr-drop-empty-attributes #t])
    (xml->xexpr (document-element (read-xml (open-input-bytes bs))))))

(define (attr x name) (match x [(list* _ (? list? as) _) (let ([a (assq name as)]) (and a (cadr a)))] [_ #f]))
(define (children x) (match x [(list* _ (? list? _as) kids) (filter pair? kids)] [_ '()]))
(define (tag x) (and (pair? x) (car x)))

;; type-spec : element-xexpr -> type-spec   from an elementType attr or a nested *TypeSpecifier
(define (qualify ns name) (if ns (string-append ns "." name) name))
(define (spec-of x)
  (case (attr x 'xsi:type)
    [("NamedTypeSpecifier") (qualify (attr x 'namespace) (attr x 'name))]
    [("ListTypeSpecifier")
     (list 'list (or (attr x 'elementType) (spec-of (car (children x)))))]
    [("IntervalTypeSpecifier") (list 'interval (or (attr x 'pointType) (spec-of (car (children x)))))]
    [("ChoiceTypeSpecifier") (cons 'choice (map spec-of (filter (lambda (c) (memq (tag c) '(choice typeSpecifier))) (children x))))]
    [else #f]))
(define (element-type e)
  (or (attr e 'elementType)
      (let ([s (findf (lambda (c) (memq (tag c) '(elementTypeSpecifier typeSpecifier))) (children e))])
        (and s (spec-of s)))
      "System.Any"))

(define (type-form t)
  (list 'type (qualify (attr t 'namespace) (attr t 'name)) (attr t 'baseType) (attr t 'identifier)
        (attr t 'primaryCodePath) (equal? (attr t 'retrievable) "true")
        (for/list ([e (children t)] #:when (eq? (tag e) 'element))
          (list (attr e 'name) (element-type e)))))

(define (main)
  (define mi (read-gz-xml src))
  (define kids (children mi))
  (define form
    (list 'model (attr mi 'name) (attr mi 'url) (attr mi 'version) (attr mi 'patientClassName)
          (attr mi 'patientBirthDatePropertyName)
          (cons 'types (for/list ([t kids] #:when (eq? (tag t) 'typeInfo)) (type-form t)))
          (cons 'conversions (for/list ([c kids] #:when (eq? (tag c) 'conversionInfo))
                               (list (attr c 'fromType) (attr c 'toType) (attr c 'functionName))))
          (cons 'contexts (for/list ([c kids] #:when (eq? (tag c) 'contextInfo))
                            (define ct (findf (lambda (k) (eq? (tag k) 'contextType)) (children c)))
                            (list (attr c 'name) (attr c 'keyElement) (qualify (attr ct 'namespace) (attr ct 'name)))))))
  (call-with-output-file out #:exists 'truncate
    (lambda (o)
      (displayln ";; GENERATED by gen-modelinfo.rkt from fhir-modelinfo-4.0.1.xml.gz — do not edit" o)
      (parameterize ([pretty-print-columns 200]) (pretty-write form o))))
  (printf "wrote ~a: ~a types, ~a conversions\n" out (length (cdr (list-ref form 6))) (length (cdr (list-ref form 7)))))

(module+ main (main))
